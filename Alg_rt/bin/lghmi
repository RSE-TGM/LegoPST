#!/usr/bin/env bash
#
# lghmi - selettore grafico delle task LegoPST che lancia la HMI draw2gr.
#
# Apre una finestra con l'elenco delle task; scegliendone una viene lanciata,
# in un processo indipendente, la HMI:
#     cd <task> ; wish $LG_TIX/draw2gr.tcl 1 f22circ
# Il selettore resta aperto; "Quit" chiude solo il selettore (le HMI restano).
#
# La sorgente della lista dipende dalla directory di lancio:
#   - se nella dir CORRENTE esiste un file "S01": la lista viene letta da esso
#     (task di PROCESSO del simulatore, tipo P - le uniche con .tom); ogni task
#     e' lanciata dalla propria dir modello (path relativo risolto sul S01).
#   - altrimenti (default): sottodir di $LG_TASKROOT ($HOME/legocad) con *.tom.
#
# Uso:   lghmi [DIR] [-proc | -staz] [-reg | -noreg] [-loc [DIR] | -noloc]
#              [-insim] [-noedit]
#
#        DIR (opzionale) e' la directory del simulatore da aprire:
#            lghmi ~/sked/<simulatore>
#   (senza -proc/-staz)
#                 mostra DUE liste affiancate: a sinistra le pagine di processo
#                 (task -> HMI draw2gr), a destra i faceplate di comando
#                 (pagine di r02.dat -> xstaz). Ogni lista ha il suo pulsante;
#                 se una delle due non ha nulla da mostrare resta vuota e lo
#                 dice la riga di stato.
#   -proc, --proc
#                 solo le pagine di processo (la lista delle task).
#   -staz, --staz
#                 modalita' FACEPLATE: invece delle task elenca le pagine di
#                 stazioni di comando compilate in r02.dat (da r01.dat con
#                 compstaz) e apre quella scelta con xstaz, avviandolo se non
#                 e' gia' attivo. Utile con net_startup, che monta il banco e
#                 non ha il dialogo delle stazioni di net_monit. Le pagine
#                 vengono cercate nella cwd, poi nelle task del file S01
#                 (regolazione compresa) o nelle sottodir di $LG_TASKROOT.
# DIR e -loc DIR sono due cose diverse, ed e' facile confonderle:
#
#     DIR (argomento nudo)   QUALE SIMULATORE MOSTRA lghmi  -> cambia la dir
#     -loc DIR               DOVE LE HMI LEGGONO I DATI     -> LG_SIM_PATH
#
# Nel flusso normale - cd nella dir del simulatore, poi lghmi - le due
# coincidono e non te ne accorgi. Servono separate solo quando devono puntare a
# due directory diverse.
#
#   DIR           (argomento nudo, opzionale) apre il selettore SU QUEL
#                 SIMULATORE, come se lghmi fosse stato lanciato da li': cambia
#                 la directory di lavoro, e con essa la modalita' (l'S01 si
#                 cerca li'), la lista dei faceplate e il Set Sim path. E'
#                 l'equivalente da riga di comando di File -> Open Simulator
#                 path.
#                     lghmi ~/sked/<simulatore>
#                 NON confonderlo con -loc DIR, che imposta soltanto dove le
#                 HMI leggono i dati vivi e lascia la directory dov'era.
#   -reg, --reg / -noreg, --noreg
#                 mostra o nasconde il riquadro delle task di REGOLAZIONE
#                 (quelle r_*, che si modificano con config invece che con la
#                 HMI). E' acceso di DEFAULT quando si vedono entrambe le liste;
#                 -reg serve a riaccenderlo insieme a -proc o -staz, che da soli
#                 lo spengono. Le regolazioni non hanno un .tom, quindi non
#                 comparivano affatto nell'elenco delle task.
#   -loc, --loc [DIR]
#                 pre-imposta il "Set Sim path" (menu View) delle HMI lanciate,
#                 via LG_SIM_PATH: e' DOVE LE HMI LEGGONO I DATI VIVI (SHM,
#                 f22circ.dat, variabili.rtf). Serve perche' una task si apre
#                 dalla sua dir MODELLO (~/legocad/<task>, dove sta il .tom)
#                 mentre i dati stanno nella dir del SIMULATORE: senza, la HMI
#                 caricherebbe lo schema giusto e cercherebbe i valori nel posto
#                 sbagliato - animazione ferma, Plot e Command a vuoto.
#                 Senza DIR usa la directory corrente; con DIR usa quella.
#                 E' il comportamento di DEFAULT.
#
#                 NON sposta il selettore: la directory di lavoro resta dov'e',
#                 quindi l'elenco delle task, i faceplate e la modalita' S01
#                 continuano a riferirsi a dove hai lanciato lghmi. Per aprire
#                 un altro simulatore si passa la DIR come argomento nudo (vedi
#                 sopra). I due sono separati apposta: si puo' lanciare lghmi
#                 dalla dir di una regolazione, per avere li' i suoi faceplate,
#                 con le HMI puntate al simulatore che gira altrove.
#   -noloc, --noloc
#                 NON pre-imposta alcun Set Sim path (LG_SIM_PATH non definito):
#                 ogni HMI parte senza sim path, da impostare a mano.
#
#   Senza DIR, -loc, -noloc e -insim lghmi riparte dall'ULTIMO Simulator
#   path usato nell'area di lavoro corrente (il primo di ~/.lghmi_recent),
#   come se lo si riaprisse da File -> Open Simulator path. Non lo fa se la
#   directory di lancio e' gia' una simulazione (c'e' un S01 o variabili.rtf:
#   cd nel simulatore e lghmi, oppure lg_cosim), ne' se quel path non esiste
#   piu': allora vale la directory di lancio, come sempre. -loc senza DIR
#   torna esplicitamente alla directory di lancio.
#   -insim, --insim
#                 il selettore e' lanciato DA DENTRO una simulazione in corso.
#                 Lo passa il banco (new_monit), che apre lghmi dal suo menu e
#                 gira nella dir del simulatore. In questo caso il selettore
#                 appartiene a quella simulazione, e vengono DISABILITATI:
#                   * File -> Open Simulator path, che lo porterebbe su un'altra
#                     directory scollegandolo dalla simulazione che l'ha aperto;
#                   * il pulsante net_startup, che con killsim ammazzerebbe
#                     proprio la simulazione da cui e' stato lanciato.
#                 Lanciando lghmi a mano non serve: i comandi restano
#                 disponibili, e net_startup chiede comunque conferma.
#                 Le HMI lanciate con -insim non hanno il menu Edit (vedi
#                 -noedit), e File -> Work area e' spento: la simulazione e'
#                 in corso.
#   -noedit, --noedit
#                 le HMI draw2gr lanciate NON hanno il menu Edit, che apre il
#                 modello della task in legopc. Senza questa opzione il menu
#                 c'e' per le task dell'area corrente ($LG_ENTRY), e mai per
#                 quelle dei bundle FMU o di un'altra area. Anche con il menu,
#                 legopc non si apre mentre la simulazione gira ne' su una
#                 task gia' aperta in un altro legopc. Tools -> Edit model del
#                 selettore resta disponibile.
#   Variabili d'ambiente:
#     LG_TASKROOT   directory delle task (default: $HOME/legocad)
#     LG_SIM_PATH   dir sim preimpostata per Set Sim path (la setta -loc)
#     LG_TIX        dir di draw2gr.tcl/lghmi.tcl (dal profilo LegoPST)
#
set -u

# cwd di lancio: catturata SUBITO, prima di ogni source/cd (serve a -loc).
LOC_DIR="$PWD"

# ---- arg parsing --------------------------------------------------------
# -loc e' il DEFAULT (LOC=1, LOC_DIR = cwd). -loc DIR usa DIR come dir di
# lancio; -noloc disabilita del tutto la pre-impostazione del sim path.
LOC=1
WISH_ARGS=()
# Diventa 1 se la riga di comando dice gia' dove lavorare (DIR, -loc, -noloc,
# -insim): allora NON si riprende l'ultimo Simulator path.
ESPLICITO=0
while [ "$#" -gt 0 ]; do
    a="$1"
    case "$a" in
        -staz|--staz)   WISH_ARGS+=("-staz") ;;
        -proc|--proc)   WISH_ARGS+=("-proc") ;;
        -noloc|--noloc) LOC=0; ESPLICITO=1 ;;
        -insim|--insim) WISH_ARGS+=("-insim"); ESPLICITO=1 ;;
        -noedit|--noedit) WISH_ARGS+=("-noedit") ;;
        -reg|--reg)     WISH_ARGS+=("-reg") ;;
        -noreg|--noreg) WISH_ARGS+=("-noreg") ;;
        -loc|--loc)
            LOC=1
            ESPLICITO=1
            # Se il prossimo argomento non e' un'opzione, e' la dir di lancio.
            if [ "$#" -ge 2 ] && [ "${2#-}" = "$2" ]; then
                LOC_DIR="$2"; shift
            fi
            ;;
        -h|--help)  sed -n '3,/^[^#]/p' "$0" | sed -n 's/^# \{0,1\}//p'; exit 0 ;;
        -*)         WISH_ARGS+=("$a") ;;
        *)
            # Argomento nudo = directory del simulatore da aprire. Si valida
            # qui per dare un errore chiaro sulla riga di comando, ma si passa
            # AL .tcl COM'E' SCRITTA: ~/sked/<sim> e' un link, e il nome con cui
            # la si chiama va conservato (lo risolve il kernel, non noi).
            if [ -n "${SIM_DIR:-}" ]; then
                echo "lghmi: una sola directory per volta ('$SIM_DIR' e '$a')." >&2
                exit 1
            fi
            if [ ! -d "$a" ]; then
                echo "lghmi: directory non trovata: $a" >&2
                exit 1
            fi
            SIM_DIR="$a"
            ESPLICITO=1
            WISH_ARGS+=("$a")
            ;;
    esac
    shift
done

# Sorgia il profilo LegoPST se l'ambiente non e' gia' impostato (LG_TIX).
if [ -z "${LG_TIX:-}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"          # .../Alg_rt/bin
    : "${LEGOROOT:=$(cd "$SCRIPT_DIR/../.." && pwd)}"    # -> LEGOROOT
    export LEGOROOT
    set +u
    # Passa "$LEGOROOT" come $1: senza argomenti il profilo EREDITEREBBE i
    # parametri posizionali dell'helper (es. -loc) e farebbe `export LEGOROOT=$1`
    # = LEGOROOT=-loc, rompendo tutti i path (LG_TIX vuoto). Stesso pattern di
    # run_fmu.sh.
    . "$LEGOROOT/.profile_legoroot" "$LEGOROOT" >/dev/null 2>&1 || true
    set -u
fi

if [ -z "${LG_TIX:-}" ] || [ ! -f "$LG_TIX/lghmi.tcl" ]; then
    echo "lghmi: LG_TIX non definito o lghmi.tcl assente (profilo LegoPST non sorgiato?)." >&2
    echo "       LG_TIX='${LG_TIX:-}'" >&2
    exit 1
fi

if ! command -v wish >/dev/null 2>&1; then
    echo "lghmi: 'wish' (Tcl/Tk) non trovato nel PATH." >&2
    exit 1
fi

# -loc (default): pre-imposta il Set Sim path delle HMI alla dir di lancio.
# -noloc: LG_SIM_PATH non definito.
# In modalita' S01 la cwd e' la dir del simulatore in esecuzione, quindi il
# default -loc fa gia' puntare animazione/Plot/Command al simulatore attivo
# (le HMI vengono lanciate dalle dir modello, ma il sim path resta questa).
if [ "$LOC" -eq 1 ]; then
    if [ ! -d "$LOC_DIR" ]; then
        echo "lghmi: directory non trovata: $LOC_DIR" >&2
        exit 1
    fi
    # Normalizza a path assoluto (LOC_DIR puo' essere relativo se dato con -loc DIR).
    LG_SIM_PATH="$(cd "$LOC_DIR" && pwd)"
    export LG_SIM_PATH
fi

# Lancio di default: il .tcl riprende l'ultimo Simulator path, se c'e' e se la
# directory di lancio non e' gia' una simulazione (lo decide lui, che ha i
# recenti e l'area corrente).
if [ "$ESPLICITO" -eq 0 ]; then
    WISH_ARGS+=("-ultimo")
fi

exec wish "$LG_TIX/lghmi.tcl" ${WISH_ARGS[@]+"${WISH_ARGS[@]}"}
