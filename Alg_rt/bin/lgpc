#!/usr/bin/env bash
#
# lgpc - lancia il CAD grafico legopc (legopc.tix).
#
# Uso:
#   lgpc              legopc vuoto: poi File -> Open Model...
#   lgpc <modello>    apre $LG_MODELS/<modello>/<modello>.tom
#   lgpc <modello>.tom   stessa cosa
#
# Usa sempre la versione corrente del CAD, quella in $LG_BIN
# (Alg_legopc/bin): LG_TIX viene impostata li' per legopc e per quello che
# legopc lancia, qualunque valore avesse prima.
#
# Era un alias di Alg_env.sh (export LG_TIX=$LG_BIN; wish $LG_TIX/legopc.tix).
# Un alias esiste solo nelle shell interattive che hanno sorgiato il profilo:
# non si poteva chiamare da uno script, da un menu, da "lgrun -a". Come
# comando si puo'. L'unica differenza: l'alias cambiava LG_TIX anche nella
# shell da cui lo si lanciava, uno script non puo' - e non serve, perche' il
# profilo la imposta gia' a $LG_BIN.
#
# Variabili d'ambiente:
#   LG_BIN   dir di legopc.tix (dal profilo LegoPST)
#
set -u

case "${1:-}" in
    -h|--help) sed -n '3,/^[^#]/p' "$0" | sed -n 's/^# \{0,1\}//p'; exit 0 ;;
esac

# Sorgia il profilo LegoPST se l'ambiente non e' gia' impostato (LG_BIN),
# come Alg_rt/bin/lghmi.
if [ -z "${LG_BIN:-}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"          # .../Alg_rt/bin
    : "${LEGOROOT:=$(cd "$SCRIPT_DIR/../.." && pwd)}"    # -> LEGOROOT
    export LEGOROOT
    set +u
    # "$LEGOROOT" come $1: senza, il profilo erediterebbe i parametri
    # posizionali di questo script (il nome del modello) e farebbe
    # export LEGOROOT=<quel nome>, rompendo tutti gli altri path.
    . "$LEGOROOT/.profile_legoroot" "$LEGOROOT" >/dev/null 2>&1 || true
    set -u
fi

if [ -z "${LG_BIN:-}" ] || [ ! -f "$LG_BIN/legopc.tix" ]; then
    echo "lgpc: LG_BIN non definito o legopc.tix assente (profilo LegoPST non sorgiato?)." >&2
    echo "      LG_BIN='${LG_BIN:-}'" >&2
    exit 1
fi

if ! command -v wish >/dev/null 2>&1; then
    echo "lgpc: 'wish' (Tcl/Tk) non trovato nel PATH." >&2
    exit 1
fi

export LG_TIX="$LG_BIN"
exec wish "$LG_TIX/legopc.tix" "$@"
