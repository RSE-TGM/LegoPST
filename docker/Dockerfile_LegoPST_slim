# Variante SNELLA dell'immagine LegoPST.
#
# Stesso ambiente di Dockerfile_LegoPST - si compila e si lavora allo stesso
# modo - ma senza il peso che non serve. Le due convivono apposta:
#
#     make -f Makefile.mk docker        -> aguagliardi/legopst_multi:2.0   (quella completa)
#     make -f Makefile.mk docker_slim   -> aguagliardi/legopst_slim:2.0    (questa)
#
# Cosa cambia, e perche' (numeri misurati con "dnf install --assumeno" su
# fedora:41, dimensione degli archivi da scaricare):
#
#   lista attuale ................................. 402 MiB
#   senza gimp .................................... 330 MiB
#   + senza dipendenze deboli ..................... 218 MiB
#   + git-core, niente documentazione ............. 289 MiB con evince (questa)
#
#  1. --setopt=install_weak_deps=False
#     E' la voce singola che pesa di piu'. Le "Recommends" di dnf tiravano
#     dentro mesa-dri-drivers (161 MB), llvm-libs (124 MB), suitesparse
#     (140 MB) e openblas-openmp (39 MB): verificato con
#     "rpm -q --whatrequires", NESSUN pacchetto installato li richiede.
#     LegoPST usa X11/Motif, non OpenGL accelerato.
#
#  2. gimp -> mtpaint
#     gimp e' solo il PRIMO di una catena di ripieghi:
#     "lg_pick LG_ICOEDITOR gimp krita drawing kolourpaint pinta mtpaint"
#     (Alg_env.sh). Serve UN editor di icone, non quello: mtpaint fa la stessa
#     cosa e con lui se ne vanno 50 pacchetti, suitesparse e openblas compresi.
#
#  3. evince RESTA, anche se zathura costerebbe 87 MiB di meno.
#     esporta.tcl apre con LG_PDFVIEWER sia i PDF sia i PNG (_openFile), e
#     zathura apre solo PDF: l'export PNG di legopc non si aprirebbe piu'.
#     mupdf, che aprirebbe entrambi, in Fedora costa addirittura piu' di
#     evince (300 MiB). Meglio 87 MiB che una funzione monca.
#
#  4. git -> git-core e tsflags=nodocs
#     Nel container git serve a generare version.h, non a lavorare sul
#     repository: bastano i comandi, non le pagine di manuale (git-core-doc da
#     solo e' 18 MB).
#
# L'altra meta' del guadagno non e' qui ma in
# Dockerfile_LegoPST_slim.dockerignore, che tiene fuori dalla copia il .git
# del repository: 631 MB che in un'immagine non servono a nessuno.

FROM fedora:41

# Raggruppa le installazioni
RUN dnf update -y && \
    dnf install -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        git-core \
        gcc \
        gfortran \
        fastfetch \
        xterm \
        xclock \
        xhost \
        xauth \
        hostname \
        glibc-langpack-en \
        libX11-devel \
        motif-devel \
        sqlite-devel \
        libbsd-devel \
        tcl tk tix \
        ncurses-devel \
        leafpad \
        gdbm-devel \
        ksh \
        which \
        sudo \
        procps-ng \
        passwd \
        cpio \
        xdg-utils \
        ghostscript \
        ImageMagick \
        mtpaint \
        evince \
        unix2dos \
        xorg-x11-fonts-misc xorg-x11-fonts-100dpi xorg-x11-fonts-75dpi libXcursor \
        adwaita-cursor-theme \
        shadow-utils && \
    dnf clean all

# Imposta le localizzazioni di base
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LANGUAGE=en_US:en

# Crea le directory e copia i file
RUN mkdir -p /home/legoroot_fedora41
COPY /LegoPST /home/legoroot_fedora41
WORKDIR /home/legoroot_fedora41/gdbm-install
RUN make -f Makefile.mk

# Configura sudoers per permettere creazione utenti dinamici
RUN echo '%wheel ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    mkdir -p /etc/sudoers.d

# Directory di lavoro di default
WORKDIR /root

# Comando di default
CMD ["tail","-f","/dev/null"]
