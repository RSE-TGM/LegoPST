# L'immagine Docker di LegoPST.
#
#     make -f Makefile.mk docker        -> aguagliardi/legopst:2.0
#     make -f Makefile.mk docker-push   -> e la pubblica
#
# Fino al 2026-09-27 ce n'erano DUE, legopst_multi (tutti i pacchetti) e
# legopst_slim (questa ricetta). Unificate su questa, per decisione
# dell'utente, dopo aver misurato che cosa le distingueva davvero: gimp, le
# dipendenze deboli e git contro git-core - 213 pacchetti e 529 MB, nessuno
# dei quali qualcosa in LegoPST richieda. Due immagini erano due cose da
# tenere allineate, e una volta non lo erano: una correzione provata sulla
# snella non c'era nella completa, che era quella che l'utente lanciava.
#
# Cosa NON si installa, e perche' (numeri misurati con "dnf install
# --assumeno" su fedora:41 e con "dnf remove --assumeno" dentro l'immagine):
#
#  1. --setopt=install_weak_deps=False
#     Le "Recommends" di dnf tiravano dentro un desktop intero: systemd-udev,
#     NetworkManager-libnm, pipewire e pulseaudio, tracker-miners, appstream,
#     la catena di perl. Circa 120 pacchetti in un container che fa X11 e
#     Motif. ATTENZIONE: mesa-dri-drivers (161 MB) e llvm-libs (124 MB)
#     restano, li vuole evince (punto 3) - "rpm -q --whatrequires" diceva il
#     contrario, ma guarda solo i nomi dei pacchetti, non i file che
#     forniscono.
#
#  2. gimp -> mtpaint
#     gimp e' solo il PRIMO di una catena di ripieghi:
#     "lg_pick LG_ICOEDITOR gimp krita drawing kolourpaint pinta mtpaint"
#     (Alg_env.sh). Serve UN editor di icone, non quello: misurato con
#     "dnf remove --assumeno gimp", con lui se ne vanno 32 pacchetti e
#     355 MB - suitesparse (140 MB) e openblas-openmp (39 MB) compresi.
#
#  3bis. firefox: serve un BROWSER, e dev'essere lui.
#     Il menu "?" di lghmi e legopc apre la documentazione HTML con
#     "exec $browser $file &" (openhelp.tcl). Senza browser la catena di
#     lg_pick cade su xdg-open, che a sua volta non trova niente: l'utente
#     vedeva venti righe di "command not found" e nessun documento.
#
#     Costo misurato nell'immagine con "dnf install --assumeno":
#         lynx 2 MiB | links 3 | w3m 9 | epiphany 69 | firefox 98 | falkon 157
#
#     epiphany costerebbe 29 MiB in meno ed e' gia' nella lista dei candidati,
#     ma NON FUNZIONA qui: usa bubblewrap per isolare i processi web, e creare
#     namespace annidati dentro un container non e' permesso - sotto podman
#     rootless a maggior ragione, perche' si e' gia' dentro un user namespace.
#     Muore con "bwrap: Creating new namespace failed: Operation not
#     permitted". Servirebbe --privileged o SYS_ADMIN: uno scambio pessimo per
#     un lettore di documentazione.
#
#     firefox incontra la stessa restrizione ("Sandbox:
#     CanCreateUserNamespace() clone() failure: EPERM") ma la DEGRADA con un
#     avviso e prosegue: verificato rendendo una pagina nel container. Non gli
#     serve nemmeno dbus.
#
#     I browser testuali costerebbero una manciata di MiB, ma openhelp.tcl li
#     lancia staccati e senza terminale: partirebbero su un terminale che non
#     c'e'. Per usarli servirebbe avvolgerli in lgterm e aggiungerli alle liste
#     di candidati in Alg_env.sh e openhelp.tcl - e resterebbe una resa scadente
#     per DOCUMENTATION_INDEX.html, che e' impaginato con CSS.
#
#     firefox e' gia' il PRIMO della lista dei candidati, quindi non si tocca
#     una riga di codice.
#
#  3ter. le utilita' di base che il dimagrimento aveva portato via.
#     Togliere le dipendenze deboli (punto 1) si e' tirato dietro anche una
#     manciata di comandi che chiunque da per scontati. Il primo a farsi
#     sentire e' stato "file": cad_maketask lo invocava sul sorgente prima di
#     copiarlo - solo per stampare, ma make interrompe la ricetta al primo
#     comando fallito - e la costruzione di una task moriva con
#         make: file: No such file or directory ... Error 127
#     che si legge come se mancasse il SORGENTE, non il comando. Quella riga
#     e' stata tolta (era l'unica invocazione di "file" nel repository), ma il
#     comando serve comunque a chi lavora dentro il container.
#
#     Costo misurato: file 49 KiB, patch 213, bc 120 (porta anche dc),
#     unzip 185, zip 450, rsync 453, nano 729, wget 1 MiB.
#     Tutti insieme: 3 MiB. Non vale la pena sceglierli a uno a uno.
#
#  3. evince RESTA, anche se zathura costerebbe 87 MiB di meno.
#     esporta.tcl apre con LG_PDFVIEWER sia i PDF sia i PNG (_openFile), e
#     zathura apre solo PDF: l'export PNG di legopc non si aprirebbe piu'.
#     mupdf, che aprirebbe entrambi, in Fedora costa addirittura piu' di
#     evince (300 MiB). Meglio 87 MiB che una funzione monca.
#
#  4. git -> git-core
#     Nel container git serve a generare version.h, non a lavorare sul
#     repository (che dentro l'immagine non ha nemmeno il .git): bastano i
#     comandi. Il metapacchetto "git" si porta dietro 70 pacchetti per 73 MB,
#     git-core-doc da solo 18 MB. Si perdono i sottocomandi in perl
#     (git send-email, git svn), che qui non servono a nessuno.
#
#     tsflags=nodocs e' RIDONDANTE: fedora:41 ce l'ha gia' nel proprio
#     /etc/dnf/dnf.conf, e infatti nell'immagine non c'e' nessuna pagina di
#     manuale nemmeno senza questa riga (verificato). Si lascia perche' non
#     costa niente e perche' un'immagine base futura potrebbe non averlo.
#
# L'altra meta' del guadagno non e' qui ma in Dockerfile_LegoPST.dockerignore,
# che tiene fuori dalla copia il .git del repository (631 MB), la cache di
# aider (41 MB) e i bundle FMU di esempio (155 MB): un layer da 462 MB invece
# di 1,33 GB, che e' quello che viaggia a ogni push e a ogni "lgdock --pull".

FROM fedora:41

# Raggruppa le installazioni
RUN dnf update -y && \
    dnf install -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        git-core \
        gcc \
        gfortran \
        fastfetch \
        xterm \
        xclock \
        xhost \
        xauth \
        hostname \
        glibc-langpack-en \
        libX11-devel \
        motif-devel \
        sqlite-devel \
        libbsd-devel \
        tcl tk tix \
        ncurses-devel \
        leafpad \
        gdbm-devel \
        ksh \
        which \
        sudo \
        procps-ng \
        passwd \
        cpio \
        xdg-utils \
        ghostscript \
        ImageMagick \
        mtpaint \
        evince \
        firefox \
        file patch nano bc wget rsync unzip zip \
        unix2dos \
        xorg-x11-fonts-misc xorg-x11-fonts-100dpi xorg-x11-fonts-75dpi libXcursor \
        adwaita-cursor-theme \
        shadow-utils && \
    dnf clean all

# Imposta le localizzazioni di base
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LANGUAGE=en_US:en

# Crea le directory e copia i file
RUN mkdir -p /home/legoroot_fedora41
COPY /LegoPST /home/legoroot_fedora41

# Il pacchetto della demo (quello che "lgrun -d" estrae nella home dell'utente).
#
# Puo' arrivare da due posti, e lgdock.sh lo cerca sempre nello stesso:
#   - da una RELEASE di GitHub, se DEMO_RELEASE e' valorizzato: lo si scarica
#     qui e se ne controlla lo sha256, cosi' un download troncato o un allegato
#     sostituito fanno fallire il build invece di finire nell'immagine;
#   - dalla copia che sta nel repository (demo/legopst_userstd.tgz), arrivata
#     con il COPY qui sopra, se DEMO_RELEASE e' vuoto.
#
# Le due righe ARG le scrive demo/publish_demo.sh dopo aver pubblicato il
# pacchetto e averlo riscaricato per controllo: non vanno toccate a mano.
# Sono anche il registro di QUALE demo sta in questa immagine.
#
# Perche' una release: un .tgz e' gia' compresso, git non riesce a fare delta
# fra due versioni e se le tiene tutte intere nella storia, per sempre. Il
# repository e' pubblico: per scaricare basta curl, senza credenziali.
ARG DEMO_RELEASE=demo-2.0
ARG DEMO_SHA256=6c32cfaeaf5ffc586745b7d0afd967cd5b76570df5bc6b49321d2c0f29ad7bf5
RUN if [ -n "$DEMO_RELEASE" ]; then \
        echo "demo: scarico la release $DEMO_RELEASE" && \
        mkdir -p /home/legoroot_fedora41/demo && \
        curl -fL --retry 3 \
            -o /home/legoroot_fedora41/demo/legopst_userstd.tgz \
            "https://github.com/RSE-TGM/LegoPST/releases/download/${DEMO_RELEASE}/legopst_userstd.tgz" && \
        echo "${DEMO_SHA256}  /home/legoroot_fedora41/demo/legopst_userstd.tgz" | sha256sum -c - ; \
    elif [ -f /home/legoroot_fedora41/demo/legopst_userstd.tgz ]; then \
        echo "demo: uso la copia nel repository" ; \
    else \
        echo "ERRORE: nessun pacchetto demo. DEMO_RELEASE e' vuoto e demo/legopst_userstd.tgz non c'e':" ; \
        echo "        pubblicalo con demo/publish_demo.sh, o rifallo con demo/make_demo_tgz.sh." ; \
        exit 1 ; \
    fi

WORKDIR /home/legoroot_fedora41/gdbm-install
RUN make -f Makefile.mk

# Configura sudoers per permettere creazione utenti dinamici
RUN echo '%wheel ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    mkdir -p /etc/sudoers.d

# Directory di lavoro di default
WORKDIR /root

# Comando di default
CMD ["tail","-f","/dev/null"]
