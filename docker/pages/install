#!/bin/bash
#
# Installs lgrun: LegoPST through Docker, without installing LegoPST.
#
#   curl -fsSL https://rse-tgm.github.io/LegoPST/install | bash
#
# With options (they go after "bash -s --"):
#   curl -fsSL https://rse-tgm.github.io/LegoPST/install | bash -s -- -h   help
#   curl -fsSL https://rse-tgm.github.io/LegoPST/install | bash -s -- -u   uninstall
#
# This file is only a short address: it downloads and runs the real
# installer, docker/install_legopst_dock.sh from the master branch, so the
# script lives in one place only. It sits in docker/pages/ and is published
# to GitHub Pages by the workflow .github/workflows/pages.yml.
#
# Everything is inside a function called on the last line: with "curl | bash"
# bash runs the script while reading it, and a download cut halfway must not
# leave half a script running.

install_lgrun() {
    local url="https://raw.githubusercontent.com/RSE-TGM/LegoPST/master/docker/install_legopst_dock.sh"
    local script
    if ! script=$(curl -fsSL "$url"); then
        echo "Error: cannot download the installer from" >&2
        echo "  $url" >&2
        return 1
    fi
    bash -c "$script" install_legopst_dock.sh "$@"
}

install_lgrun "$@"
