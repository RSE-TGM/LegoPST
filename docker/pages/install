#!/bin/bash
#
# Installa lgrun: LegoPST via Docker, senza installare LegoPST.
#
#   curl -fsSL https://rse-tgm.github.io/LegoPST/install | bash
#
# Con opzioni (vanno dopo "bash -s --"):
#   curl -fsSL https://rse-tgm.github.io/LegoPST/install | bash -s -- -h   aiuto
#   curl -fsSL https://rse-tgm.github.io/LegoPST/install | bash -s -- -u   disinstalla
#
# Questo file e' solo un indirizzo corto: scarica ed esegue il vero
# installatore, docker/install_legopst_dock.sh dal branch master, cosi' lo
# script esiste in un posto solo. Sta in docker/pages/ e lo pubblica su
# GitHub Pages il workflow .github/workflows/pages.yml.
#
# Tutto e' dentro una funzione chiamata all'ultima riga: con "curl | bash"
# bash esegue mentre legge, e un download interrotto a meta' non deve
# lasciar girare mezzo script.

installa_lgrun() {
    local url="https://raw.githubusercontent.com/RSE-TGM/LegoPST/master/docker/install_legopst_dock.sh"
    local script
    if ! script=$(curl -fsSL "$url"); then
        echo "Errore: non riesco a scaricare l'installatore da" >&2
        echo "  $url" >&2
        return 1
    fi
    bash -c "$script" install_legopst_dock.sh "$@"
}

installa_lgrun "$@"
